{
  "name": "regional-watch-editor",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
