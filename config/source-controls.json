        "marad_official",
        "mil_lol",
        "mscio",
        "polymarket",
        "satellite_context",
        "state_dept",
        "unosat_analysis",
        "us_dod_rss"
      ],
      "workflows": {
        "adsb-mil.yml": "mil_lol",
        "adsb.yml": "adsb",
        "centcom-test.yml": "centcom_dvids",
        "copernicus-analytics.yml": "copernicus_ems",
        "gdelt.yml": "gdelt_context",
        "marad.yml": "marad_official",
